# Backend environment variables
# Copy this file to .env and fill in your real values

# Server
PORT=5000
NODE_ENV=development

# Database — get this from MongoDB Atlas
MONGO_URI=mongodb://localhost:27017/expense_tracker

# JWT secret — generate a long random string for production
# You can generate one by running: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_secret_string_for_production
JWT_EXPIRES_IN=7d

# CORS — your frontend URL
CLIENT_URL=http://localhost:5173
